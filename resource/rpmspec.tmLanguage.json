{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "RPM Spec",
    "fileTypes": ["spec"],
    "scopeName": "source.spec",
    "uuid": "49e56b70-cf79-11e1-9b23-0800200c9a66",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#sections"
        },
        {
            "include": "#conditionals"
        },
        {
            "include": "#macroDefinitions"
        },
        {
            "include": "#preambleTags"
        },
        {
            "include": "#builtinDirectives"
        },
        {
            "include": "#filesDirectives"
        },
        {
            "include": "#macros"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "comment": "OBS (Open Build Service) special comment directives",
                    "match": "^\\s*(#(?:\\s*(?:norootforbuild|needsrootforbuild|needsbinariesforbuild|icecream)\\b|![A-Za-z]+:).*)$",
                    "name": "keyword.other.obs.spec"
                },
                {
                    "comment": "RPM %dnl (discard to next line) macro comment",
                    "match": "(%dnl)\\b.*$",
                    "captures": {
                        "1": {
                            "name": "keyword.control.spec"
                        }
                    },
                    "name": "comment.line.dnl.spec"
                },
                {
                    "match": "^\\s*#.*$",
                    "name": "comment.line.number-sign.spec"
                }
            ]
        },
        "sections": {
            "patterns": [
                {
                    "begin": "^(%changelog)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.section.spec"
                        }
                    },
                    "end": "^(?=%(?:package|description|prep|conf|generate_buildrequires|mkbuilddir|build|install|check|clean|files|sourcelist|patchlist|pre|post|preun|postun|pretrans|posttrans|preuntrans|postuntrans|trigger(?:prein|in|un|postun)|(?:trans)?filetrigger(?:in|un|postun)|verifyscript|end)\\b)",
                    "name": "meta.section.changelog.spec",
                    "patterns": [
                        {
                            "comment": "Changelog entry header: * Day Mon DD YYYY Name <email> - version-release",
                            "match": "^(\\*\\s+(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)\\s+(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\\s+\\d{1,2}\\s+\\d{4})\\s+([^<\\n]+?)(?:\\s*(<[^>]+>))?(?:\\s+(-\\s*.*))?$",
                            "captures": {
                                "1": {
                                    "name": "constant.numeric.date.spec"
                                },
                                "2": {
                                    "name": "entity.name.author.spec"
                                },
                                "3": {
                                    "name": "markup.underline.link.email.spec"
                                },
                                "4": {
                                    "name": "constant.numeric.version.spec"
                                }
                            },
                            "name": "meta.changelog.header.spec"
                        },
                        {
                            "comment": "Fallback for non-standard changelog headers starting with *",
                            "match": "^\\*\\s+.*$",
                            "name": "meta.documentation.spec"
                        },
                        {
                            "include": "#comments"
                        }
                    ]
                },
                {
                    "begin": "^(%description)\\b(.*)$",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.section.spec"
                        },
                        "2": {
                            "patterns": [
                                {
                                    "match": "(-[nl])\\s+(\\S+)",
                                    "captures": {
                                        "1": {
                                            "name": "variable.parameter.option.spec"
                                        },
                                        "2": {
                                            "name": "entity.name.section.spec"
                                        }
                                    }
                                },
                                {
                                    "match": "\\S+",
                                    "name": "entity.name.section.spec"
                                }
                            ]
                        }
                    },
                    "end": "^(?=%(?:package|description|prep|conf|generate_buildrequires|mkbuilddir|build|install|check|clean|files|changelog|sourcelist|patchlist|pre|post|preun|postun|pretrans|posttrans|preuntrans|postuntrans|trigger(?:prein|in|un|postun)|(?:trans)?filetrigger(?:in|un|postun)|verifyscript|end)\\b)",
                    "name": "meta.section.description.spec",
                    "contentName": "string.unquoted.description.spec",
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "include": "#conditionals"
                        },
                        {
                            "include": "#macros"
                        }
                    ]
                },
                {
                    "match": "^(%package)\\s+(?:(-n)\\s+)?(\\S+)",
                    "captures": {
                        "1": {
                            "name": "keyword.control.section.spec"
                        },
                        "2": {
                            "name": "variable.parameter.option.spec"
                        },
                        "3": {
                            "name": "entity.name.section.spec"
                        }
                    }
                },
                {
                    "match": "^(%(?:prep|conf|generate_buildrequires|mkbuilddir|build|install|check|clean|files|sourcelist|patchlist|pre|post|preun|postun|pretrans|posttrans|preuntrans|postuntrans|trigger(?:prein|in|un|postun)|(?:trans)?filetrigger(?:in|un|postun)|verifyscript|end))\\b(.*)$",
                    "captures": {
                        "1": {
                            "name": "keyword.control.section.spec"
                        },
                        "2": {
                            "patterns": [
                                {
                                    "match": "<lua>",
                                    "name": "support.type.interpreter.spec"
                                },
                                {
                                    "match": "(-[a-zA-Z]+)\\b",
                                    "name": "variable.parameter.option.spec"
                                },
                                {
                                    "include": "#macros"
                                },
                                {
                                    "match": "\\S+",
                                    "name": "entity.name.section.spec"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "preambleTags": {
            "patterns": [
                {
                    "comment": "Architecture-specific tags with built-in arch validation",
                    "begin": "(?i)^\\s*(BuildArch|BuildArchitectures|ExclusiveArch|ExcludeArch):",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.other.tag.spec"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#archShortcuts"
                        },
                        {
                            "include": "#archValues"
                        },
                        {
                            "include": "#macros"
                        },
                        {
                            "match": "\\S+",
                            "name": "invalid.illegal.arch.spec"
                        }
                    ]
                },
                {
                    "comment": "Declarative Buildsystem tags (RPM 4.20+)",
                    "begin": "(?i)^\\s*(BuildSystem|BuildOption(?:\\((?:prep|conf|build|install|check|clean|generate_buildrequires)\\))?):",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.other.tag.buildsystem.spec"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#macros"
                        },
                        {
                            "include": "#stringValue"
                        }
                    ]
                },
                {
                    "begin": "(?i)^\\s*(Name|Version|Release|Epoch|Serial):",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.other.tag.spec"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#macros"
                        },
                        {
                            "include": "#versionString"
                        },
                        {
                            "include": "#numericConstant"
                        },
                        {
                            "include": "#stringValue"
                        }
                    ]
                },
                {
                    "begin": "(?i)^\\s*(AutoReq|AutoProv|AutoReqProv|NoSource|NoPatch):",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.other.tag.spec"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "match": "(?i)\\b(yes|no|true|false|0|1)\\b",
                            "name": "constant.language.boolean.spec"
                        },
                        {
                            "include": "#numericConstant"
                        },
                        {
                            "include": "#macros"
                        }
                    ]
                },
                {
                    "comment": "Dependency tags supporting version operators and rich/boolean dependencies",
                    "begin": "(?i)^\\s*(Requires(?:\\([^)]*\\))?|BuildRequires|BuildPrereq|Conflicts|BuildConflicts|Obsoletes|Provides|Recommends|Suggests|Enhances|Supplements|OrderWithRequires|PreReq):",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.other.tag.spec"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#richDepOperators"
                        },
                        {
                            "include": "#logicalOperators"
                        },
                        {
                            "include": "#macros"
                        },
                        {
                            "include": "#stringValue"
                        }
                    ]
                },
                {
                    "comment": "General metadata, source, patch, and build tags",
                    "begin": "(?i)^\\s*(Summary(?:\\([^)]*\\))?|License|SourceLicense|URL|VCS|BugURL|TranslationURL|Group|Distribution|Vendor|Packager|Copyright|Source\\d*|Patch\\d*|BuildRoot|Prefix|Prefixes|DocDir|Icon|ExclusiveOS|ExcludeOS|ModularityLabel|RemovePathPostfixes|DistTag):",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.other.tag.spec"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#macros"
                        },
                        {
                            "include": "#stringValue"
                        }
                    ]
                }
            ]
        },
        "macroDefinitions": {
            "patterns": [
                {
                    "comment": "Parameterized macro definition: %define/%global name(opts) body",
                    "begin": "(%(?:global|define))\\s+([A-Za-z_][A-Za-z0-9_]*)(\\([^)]*\\))",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.macro.spec"
                        },
                        "2": {
                            "name": "entity.name.function.spec"
                        },
                        "3": {
                            "name": "punctuation.definition.parameters.spec"
                        }
                    },
                    "end": "(?<!\\\\)$",
                    "patterns": [
                        {
                            "include": "#macros"
                        },
                        {
                            "include": "#logicalOperators"
                        },
                        {
                            "include": "#numericConstant"
                        },
                        {
                            "include": "#stringValue"
                        }
                    ]
                },
                {
                    "comment": "Simple macro definition: %define/%global name body",
                    "begin": "(%(?:global|define))\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.macro.spec"
                        },
                        "2": {
                            "name": "variable.name.spec"
                        }
                    },
                    "end": "(?<!\\\\)$",
                    "patterns": [
                        {
                            "include": "#macros"
                        },
                        {
                            "include": "#logicalOperators"
                        },
                        {
                            "include": "#versionString"
                        },
                        {
                            "include": "#numericConstant"
                        },
                        {
                            "include": "#stringValue"
                        }
                    ]
                },
                {
                    "comment": "Conditional build options: %bcond, %bcond_with, %bcond_without",
                    "match": "(%bcond(?:_with|_without)?)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(\\S+))?",
                    "captures": {
                        "1": {
                            "name": "keyword.control.macro.spec"
                        },
                        "2": {
                            "name": "variable.name.spec"
                        },
                        "3": {
                            "name": "constant.numeric.spec"
                        }
                    }
                },
                {
                    "match": "(%undefine)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.control.macro.spec"
                        },
                        "2": {
                            "name": "variable.name.spec"
                        }
                    }
                }
            ]
        },
        "conditionals": {
            "patterns": [
                {
                    "comment": "Architecture conditionals with built-in invalid arch detection",
                    "begin": "^\\s*(%(?:ifarch|ifnarch|elifarch))\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.conditional.spec"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#archShortcuts"
                        },
                        {
                            "include": "#archValues"
                        },
                        {
                            "include": "#macros"
                        },
                        {
                            "match": "\\S+",
                            "name": "invalid.illegal.arch.spec"
                        }
                    ]
                },
                {
                    "begin": "^\\s*(%(?:if|elif|ifos|ifnos|elifos))\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.conditional.spec"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#versionLiteral"
                        },
                        {
                            "include": "#logicalOperators"
                        },
                        {
                            "include": "#macros"
                        },
                        {
                            "include": "#numericConstant"
                        },
                        {
                            "match": "\"[^\"]*\"",
                            "name": "string.quoted.double.spec"
                        }
                    ]
                },
                {
                    "match": "^\\s*(%(?:else|endif))\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.conditional.spec"
                        }
                    }
                }
            ]
        },
        "builtinDirectives": {
            "patterns": [
                {
                    "comment": "Built-in %prep, include, and diagnostic directives",
                    "match": "(%(?:setup|autosetup|autopatch|patch\\d*|include|load|echo|warn|error|trace|dump))\\b",
                    "name": "support.function.builtin.spec"
                }
            ]
        },
        "filesDirectives": {
            "patterns": [
                {
                    "match": "(%(?:defattr|attr|config|verify|defverify|caps|lang|dev))(\\([^)]*\\))?",
                    "captures": {
                        "1": {
                            "name": "keyword.other.files.spec"
                        },
                        "2": {
                            "name": "variable.parameter.files.spec"
                        }
                    }
                },
                {
                    "match": "(%(?:doc|docdir|dir|ghost|license|readme|exclude|artifact|missingok|noreplace|pubkey))\\b",
                    "name": "keyword.other.files.spec"
                }
            ]
        },
        "macros": {
            "patterns": [
                {
                    "comment": "Escaped literal percent sign",
                    "match": "%%",
                    "name": "constant.character.escape.spec"
                },
                {
                    "comment": "RPM expression expansion %[...]",
                    "begin": "(%\\[)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.operator.macro.spec"
                        }
                    },
                    "end": "(\\])",
                    "endCaptures": {
                        "1": {
                            "name": "keyword.operator.macro.spec"
                        }
                    },
                    "name": "meta.macro.expression.spec",
                    "patterns": [
                        {
                            "include": "#versionLiteral"
                        },
                        {
                            "include": "#macros"
                        },
                        {
                            "include": "#logicalOperators"
                        },
                        {
                            "include": "#numericConstant"
                        },
                        {
                            "match": "\"[^\"]*\"",
                            "name": "string.quoted.double.spec"
                        }
                    ]
                },
                {
                    "comment": "RPM shell expansion %(...)",
                    "begin": "(%\\()",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.operator.macro.spec"
                        }
                    },
                    "end": "(\\))",
                    "endCaptures": {
                        "1": {
                            "name": "keyword.operator.macro.spec"
                        }
                    },
                    "name": "meta.macro.shell.spec",
                    "patterns": [
                        {
                            "include": "#macros"
                        }
                    ]
                },
                {
                    "comment": "Braced macro expansion %{...} with nesting, built-in functions, and conditional support",
                    "begin": "(%\\{)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.operator.macro.spec"
                        }
                    },
                    "end": "(\\})",
                    "endCaptures": {
                        "1": {
                            "name": "keyword.operator.macro.spec"
                        }
                    },
                    "name": "meta.macro.braced.spec",
                    "patterns": [
                        {
                            "include": "#macros"
                        },
                        {
                            "match": "(!\\?|!|\\?)",
                            "name": "keyword.operator.ternary.spec"
                        },
                        {
                            "match": "\\b(lua|expr|expand|quote|gsub|sub|len|lower|upper|rep|reverse|shescape|shrink|dirname|basename|suffix|uncompress|getenv|exists|defined|undefined|with|without|verbose|S|P|F)(:)",
                            "captures": {
                                "1": {
                                    "name": "support.function.macro.spec"
                                },
                                "2": {
                                    "name": "keyword.operator.ternary.spec"
                                }
                            }
                        },
                        {
                            "match": "(:)",
                            "name": "keyword.operator.ternary.spec"
                        },
                        {
                            "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
                            "name": "variable.name.spec"
                        }
                    ]
                },
                {
                    "comment": "Macro positional arguments (%0, %1, %*, %**, %#)",
                    "match": "%(?:\\*\\*|[*#0-9])",
                    "name": "variable.parameter.macro.spec"
                },
                {
                    "comment": "Simple unbraced macro %name",
                    "match": "%([A-Za-z_][A-Za-z0-9_]*)",
                    "name": "variable.other.macro.spec"
                }
            ]
        },
        "versionLiteral": {
            "comment": "RPM 4.16+ version comparison literal v\"1.2.3\"",
            "match": "v\"[^\"]*\"",
            "name": "constant.numeric.version.spec"
        },
        "archValues": {
            "match": "\\b(noarch|aarch64|alpha|alphaev5|alphaev56|alphaev6|alphaev67|alphapca56|amd64|armv3l|armv4b|armv4l|armv5tejl|armv5tel|armv5tl|armv6hl|armv6l|armv7hl|armv7hnl|armv7l|armv8hl|armv8l|athlon|em64t|geode|i370|i386|i486|i586|i686|ia32e|ia64|loongarch64|m68k|m68kmint|mips|mips64|mips64el|mips64r6|mips64r6el|mipsel|mipsr6|mipsr6el|pentium3|pentium4|ppc|ppc32dy4|ppc64|ppc64iseries|ppc64le|ppc64p7|ppc64pseries|ppc8260|ppc8560|ppciseries|ppcpseries|riscv32|riscv64|rs6000|s390|s390x|sgi|sh|sh3|sh4|sh4a|sparc|sparc64|sparc64v|sparcv8|sparcv9|sparcv9v|x86_64|x86_64_v2|x86_64_v3|x86_64_v4|xtensa)\\b",
            "name": "constant.language.arch.spec"
        },
        "archShortcuts": {
            "match": "%\\{(alpha|arm|arm32|arm64|ix86|loongarch64|mips|mips32|mips64|mipseb|mipsel|power64|riscv32|riscv64|riscv128|sparc|x86_64)\\}",
            "name": "constant.language.arch.spec"
        },
        "richDepOperators": {
            "match": "\\b(and|or|if|else|unless|with|without)\\b",
            "name": "keyword.operator.logical.richdep.spec"
        },
        "logicalOperators": {
            "match": "(<=|>=|==|!=|&&|\\|\\||<|>|!)",
            "name": "keyword.operator.logical.spec"
        },
        "numericConstant": {
            "match": "\\b[0-9]+\\b",
            "name": "constant.numeric.spec"
        },
        "versionString": {
            "comment": "Version numbers with dots, e.g. 56.0.0",
            "match": "\\b[0-9]+(?:\\.[0-9]+)+\\b",
            "name": "string.unquoted.spec"
        },
        "stringValue": {
            "match": "[\\w\\-\\.:/,\\+~]+",
            "name": "string.unquoted.spec"
        }
    }
}
